# Grouped by the package that reads each variable. Settings classes load this
# file from the current working directory, so run services from the repo root.

# --- Shared: gateway, clients/cli, clients/voice ------------------------------
# Bearer token the Gateway requires and every client sends (minimum 32 chars).
# Generate and append one to .env with: bash scripts/setup/generate_gateway_token.sh
CARA_GATEWAY_TOKEN=replace_with_a_random_gateway_token

# --- gateway ------------------------------------------------------------------
# The model client authenticates via the Codex CLI (~/.codex/auth.json), not an
# API key.
# Workspace exposed to the agent; overrides workspace.root in gateway.yml.
# Also used by compose.yml and scripts/setup/prepare_bash_sandbox.sh.
# CARA_WORKSPACE_ROOT=/path/to/cara-workspace
# Gateway database, also used by gateway migrations (this is the default).
# DATABASE_URL=sqlite+aiosqlite:///./gateway.sqlite3
# Voice sessions (speech-to-text and text-to-speech). Required: the Gateway
# refuses to start without it. Create a key at https://console.deepgram.com.
CARA_GATEWAY_VOICE_DEEPGRAM_API_KEY=your_deepgram_api_key
# Gateway-owned wait for another utterance after assistant playback.
# CARA_GATEWAY_VOICE_CONVERSATION_FOLLOW_UP_DELAY_SECONDS=0.5
# CARA_GATEWAY_VOICE_CONVERSATION_INACTIVITY_TIMEOUT_SECONDS=5
# CARA_GATEWAY_VOICE_CONVERSATION_INACTIVITY_COUNTDOWN_SECONDS=3

# --- cara-tools ---------------------------------------------------------------
# Required only when the info_search tool is called.
TAVILY_API_KEY=your_tavily_api_key

# --- clients/voice ------------------------------------------------------------
# Philips Hue, used by HueIntegration - run scripts/discover_hue.sh to obtain these.
HUE_BRIDGE_IP=your_hue_bridge_ip
HUE_APP_KEY=your_hue_app_key

# Sonos speaker, required by SonosOutput - run scripts/discover_sonos.sh.
SONOS_IP_ADDRESS=192.168.1.42
# Optional: local interface the speaker should use to fetch hosted audio clips.
# SONOS_LOCAL_HOST=192.168.1.10

# --- compose.yml: minio, minio-init -------------------------------------------
# Object storage (S3 API on :9000, web console on :9001). No Python package
# reads these yet.
# CARA_MINIO_ROOT_USER=cara
# CARA_MINIO_ROOT_PASSWORD=change-me-minio-password
# CARA_MINIO_BUCKET=cara
