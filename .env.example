OPENAI_API_KEY=your_open_api_key

# Philips Hue - run scripts/discover_hue.sh to obtain these
HUE_BRIDGE_IP=your_hue_bridge_ip
HUE_APP_KEY=your_hue_app_key

ELEVENLABS_API_KEY=your_eleven_labs_api_key

TAVILY_API_KEY=your_tavily_api_key

# Sonos - run scripts/discover_sonos.sh to find these values
SONOS_SPEAKER_NAME=your_sonos_speaker_name
# Optional: skips discovery and addresses the speaker directly.
SONOS_IP_ADDRESS=192.168.1.42
# Optional: local interface the speaker should use to fetch hosted audio clips.
# SONOS_LOCAL_HOST=192.168.1.10

# SPOTIFY
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=your_spotify_redirect_uri
SPOTIFY_CACHE_PATH=../spotifyify/.cache

# optional cerebrase for experiments
CEREBRAS_API_KEY=your_cerebas_api_key
