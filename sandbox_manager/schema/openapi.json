{
  "openapi": "3.1.0",
  "info": {
    "title": "Cara Sandbox Manager",
    "version": "1"
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Check Sandbox Manager health",
        "operationId": "get_health",
        "responses": {
          "200": {
            "description": "The Sandbox Manager process is alive.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/readiness": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Check Sandbox Manager readiness",
        "operationId": "get_readiness",
        "responses": {
          "200": {
            "description": "The Sandbox Manager can create sandboxes and serve files.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/DependencyUnavailableProblem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workspaces/{workspace_id}/sandbox": {
      "put": {
        "tags": [
          "sandboxes"
        ],
        "summary": "Start the workspace sandbox unless it is already running",
        "operationId": "ensure_sandbox",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Workspace Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SandboxResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid workspace id",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidWorkspaceIdProblem"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationProblem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "sandboxes"
        ],
        "summary": "Stop the workspace sandbox",
        "operationId": "stop_sandbox",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Workspace Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The sandbox is not running."
          },
          "422": {
            "description": "Request validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workspaces/{workspace_id}/exec": {
      "post": {
        "tags": [
          "sandboxes"
        ],
        "summary": "Run a command in the workspace sandbox",
        "operationId": "execute",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Workspace Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExecRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecResponse"
                }
              }
            }
          },
          "400": {
            "description": "Possible problems: Invalid workspace id, Stdin not supported",
            "content": {
              "application/problem+json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/InvalidWorkspaceIdProblem"
                    },
                    {
                      "$ref": "#/components/schemas/StdinNotSupportedProblem"
                    }
                  ],
                  "discriminator": {
                    "propertyName": "code",
                    "mapping": {
                      "invalid_workspace_id": "#/components/schemas/InvalidWorkspaceIdProblem",
                      "stdin_not_supported": "#/components/schemas/StdinNotSupportedProblem"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workspaces/{workspace_id}/files/{file_path}": {
      "get": {
        "tags": [
          "files"
        ],
        "summary": "Read a UTF-8 text file",
        "operationId": "read_file",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Workspace Id"
            }
          },
          {
            "name": "file_path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "File Path"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "File not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/FileNotFoundProblem"
                }
              }
            }
          },
          "403": {
            "description": "Path outside workspace",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PathOutsideWorkspaceProblem"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationProblem"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "files"
        ],
        "summary": "Write a UTF-8 text file, creating parent directories",
        "operationId": "write_file",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Workspace Id"
            }
          },
          {
            "name": "file_path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "File Path"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FileWriteRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "The file was written."
          },
          "403": {
            "description": "Path outside workspace",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PathOutsideWorkspaceProblem"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workspaces/{workspace_id}/edit/{file_path}": {
      "post": {
        "tags": [
          "files"
        ],
        "summary": "Replace text in a file",
        "operationId": "edit_file",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Workspace Id"
            }
          },
          {
            "name": "file_path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "File Path"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FileEditRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileEditResponse"
                }
              }
            }
          },
          "404": {
            "description": "File not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/FileNotFoundProblem"
                }
              }
            }
          },
          "403": {
            "description": "Path outside workspace",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PathOutsideWorkspaceProblem"
                }
              }
            }
          },
          "400": {
            "description": "Invalid edit",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidEditProblem"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workspaces/{workspace_id}/entries": {
      "get": {
        "tags": [
          "files"
        ],
        "summary": "List a directory",
        "operationId": "list_entries",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Workspace Id"
            }
          },
          {
            "name": "directory",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": ".",
              "title": "Directory"
            }
          },
          {
            "name": "recursive",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Recursive"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FileEntry"
                  },
                  "title": "Response List Entries"
                }
              }
            }
          },
          "403": {
            "description": "Path outside workspace",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PathOutsideWorkspaceProblem"
                }
              }
            }
          },
          "400": {
            "description": "Not a directory",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/NotADirectoryProblem"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workspaces/{workspace_id}/glob": {
      "get": {
        "tags": [
          "files"
        ],
        "summary": "Find paths matching a glob pattern",
        "operationId": "glob_files",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Workspace Id"
            }
          },
          {
            "name": "pattern",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Pattern"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FileEntry"
                  },
                  "title": "Response Glob Files"
                }
              }
            }
          },
          "403": {
            "description": "Path outside workspace",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PathOutsideWorkspaceProblem"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workspaces/{workspace_id}/grep": {
      "post": {
        "tags": [
          "files"
        ],
        "summary": "Search file contents with a regular expression",
        "operationId": "grep_files",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Workspace Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GrepRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FileMatch"
                  },
                  "title": "Response Grep Files"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workspaces/{workspace_id}/stat": {
      "get": {
        "tags": [
          "files"
        ],
        "summary": "Describe a path, or return null if it does not exist",
        "operationId": "stat_file",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Workspace Id"
            }
          },
          {
            "name": "file_path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "File Path"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/FileEntry"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Response Stat File"
                }
              }
            }
          },
          "403": {
            "description": "Path outside workspace",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PathOutsideWorkspaceProblem"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationProblem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ExecRequest": {
        "properties": {
          "argv": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Argv"
          },
          "cwd": {
            "type": "string",
            "title": "Cwd",
            "default": "/workspace"
          },
          "env": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Env"
          },
          "stdin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stdin"
          },
          "timeout_seconds": {
            "type": "number",
            "maximum": 3600.0,
            "exclusiveMinimum": 0.0,
            "title": "Timeout Seconds",
            "default": 15
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "argv"
        ],
        "title": "ExecRequest"
      },
      "ExecResponse": {
        "properties": {
          "exit_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exit Code"
          },
          "stdout": {
            "type": "string",
            "title": "Stdout"
          },
          "stderr": {
            "type": "string",
            "title": "Stderr"
          },
          "timed_out": {
            "type": "boolean",
            "title": "Timed Out",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "exit_code",
          "stdout",
          "stderr"
        ],
        "title": "ExecResponse"
      },
      "FileEditRequest": {
        "properties": {
          "old": {
            "type": "string",
            "title": "Old"
          },
          "new": {
            "type": "string",
            "title": "New"
          },
          "replace_all": {
            "type": "boolean",
            "title": "Replace All",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "old",
          "new"
        ],
        "title": "FileEditRequest"
      },
      "FileEditResponse": {
        "properties": {
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "count"
        ],
        "title": "FileEditResponse"
      },
      "FileEntry": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "is_dir": {
            "type": "boolean",
            "title": "Is Dir"
          },
          "is_symlink": {
            "type": "boolean",
            "title": "Is Symlink"
          },
          "size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Size"
          },
          "modified": {
            "type": "number",
            "title": "Modified"
          }
        },
        "type": "object",
        "required": [
          "path",
          "is_dir",
          "is_symlink",
          "size",
          "modified"
        ],
        "title": "FileEntry"
      },
      "FileMatch": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "line_number": {
            "type": "integer",
            "title": "Line Number"
          },
          "line": {
            "type": "string",
            "title": "Line"
          },
          "context_before": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Context Before"
          },
          "context_after": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Context After"
          }
        },
        "type": "object",
        "required": [
          "path",
          "line_number",
          "line",
          "context_before",
          "context_after"
        ],
        "title": "FileMatch"
      },
      "FileWriteRequest": {
        "properties": {
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "content"
        ],
        "title": "FileWriteRequest"
      },
      "GrepRequest": {
        "properties": {
          "pattern": {
            "type": "string",
            "title": "Pattern"
          },
          "glob": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Glob"
          },
          "case_sensitive": {
            "type": "boolean",
            "title": "Case Sensitive",
            "default": true
          },
          "context_lines": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Context Lines",
            "default": 0
          },
          "max_matches": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Matches"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "pattern"
        ],
        "title": "GrepRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "HealthResponse"
      },
      "ReadinessResponse": {
