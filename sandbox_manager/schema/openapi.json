  "components": {
    "schemas": {
      "ExecRequest": {
        "properties": {
          "argv": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Argv"
          },
          "cwd": {
            "type": "string",
            "title": "Cwd",
            "default": "/workspace"
          },
          "env": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Env"
          },
          "stdin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stdin"
          },
          "timeout_seconds": {
            "type": "number",
            "maximum": 3600.0,
            "exclusiveMinimum": 0.0,
            "title": "Timeout Seconds",
            "default": 15
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "argv"
        ],
        "title": "ExecRequest"
      },
      "ExecResponse": {
        "properties": {
          "exit_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exit Code"
          },
          "stdout": {
            "type": "string",
            "title": "Stdout"
          },
          "stderr": {
            "type": "string",
            "title": "Stderr"
          },
          "timed_out": {
            "type": "boolean",
            "title": "Timed Out",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "exit_code",
          "stdout",
          "stderr"
        ],
        "title": "ExecResponse"
      },
      "FileEditRequest": {
        "properties": {
          "old": {
            "type": "string",
            "title": "Old"
          },
          "new": {
            "type": "string",
            "title": "New"
          },
          "replace_all": {
            "type": "boolean",
            "title": "Replace All",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "old",
          "new"
        ],
        "title": "FileEditRequest"
      },
      "FileEditResponse": {
        "properties": {
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "count"
        ],
        "title": "FileEditResponse"
      },
      "FileEntry": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "is_dir": {
            "type": "boolean",
            "title": "Is Dir"
          },
          "is_symlink": {
            "type": "boolean",
            "title": "Is Symlink"
          },
          "size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Size"
          },
          "modified": {
            "type": "number",
            "title": "Modified"
          }
        },
        "type": "object",
        "required": [
          "path",
          "is_dir",
          "is_symlink",
          "size",
          "modified"
        ],
        "title": "FileEntry"
      },
      "FileMatch": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "line_number": {
            "type": "integer",
            "title": "Line Number"
          },
          "line": {
            "type": "string",
            "title": "Line"
          },
          "context_before": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Context Before"
          },
          "context_after": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Context After"
          }
        },
        "type": "object",
        "required": [
          "path",
          "line_number",
          "line",
          "context_before",
          "context_after"
        ],
        "title": "FileMatch"
      },
      "FileWriteRequest": {
        "properties": {
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "content"
        ],
        "title": "FileWriteRequest"
      },
      "GrepRequest": {
        "properties": {
          "pattern": {
            "type": "string",
            "title": "Pattern"
          },
          "glob": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Glob"
          },
          "case_sensitive": {
            "type": "boolean",
            "title": "Case Sensitive",
            "default": true
          },
          "context_lines": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Context Lines",
            "default": 0
          },
          "max_matches": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Matches"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "pattern"
        ],
        "title": "GrepRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SandboxResponse": {
        "properties": {
          "workspace_id": {
            "type": "string",
            "title": "Workspace Id"
          },
          "container_id": {
            "type": "string",
            "title": "Container Id"
          }
        },
        "type": "object",
        "required": [
          "workspace_id",
          "container_id"
        ],
        "title": "SandboxResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
