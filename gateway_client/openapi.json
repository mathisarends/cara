{
  "openapi": "3.1.0",
  "info": {
    "title": "Cara Gateway API",
    "summary": "Session-based gateway for Cara clients.",
    "description": "Create and inspect sessions through HTTP. Send commands and receive turn, chat, and tool-call events through the versioned WebSocket API.",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Check gateway health",
        "operationId": "get_gateway_health",
        "responses": {
          "200": {
            "description": "The gateway process is alive.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/_HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/readiness": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Check gateway readiness",
        "operationId": "get_gateway_readiness",
        "responses": {
          "200": {
            "description": "The gateway application stack is ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/_ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions": {
      "post": {
        "tags": [
          "sessions"
        ],
        "summary": "Create a session",
        "operationId": "create_session",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The newly created session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{session_id}": {
      "get": {
        "tags": [
          "sessions"
        ],
        "summary": "Get a session",
        "operationId": "get_session",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The requested session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "404": {
            "description": "Session not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{session_id}/chat": {
      "post": {
        "tags": [
          "sessions"
        ],
        "summary": "Start a chat turn",
        "operationId": "start_chat",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/schemas/events": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Get the WebSocket event schema",
        "operationId": "get_event_schema",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get Event Schema"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "title": "Text"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "ChatRequest"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "Human-readable error description."
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SessionCreateRequest": {
        "properties": {
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata",
            "description": "Client-defined session metadata used for routing context.",
            "examples": [
              {
                "channel": "terminal"
              }
            ]
          }
        },
        "type": "object",
        "title": "SessionCreateRequest"
      },
      "SessionResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id",
            "description": "Stable session identifier."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "UTC timestamp when the session was created."
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata",
            "description": "Client-defined session metadata."
          }
        },
        "type": "object",
        "required": [
          "id",
          "created_at",
          "metadata"
        ],
        "title": "SessionResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "_HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "_HealthResponse"
      },
      "_ReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ready",
            "title": "Status",
            "default": "ready"
          }
        },
        "type": "object",
        "title": "_ReadinessResponse"
      },
      "ChatCompletedEvent": {
        "properties": {
          "type": {
            "const": "chat.completed",
            "title": "Type",
            "type": "string"
          },
          "event_id": {
            "format": "uuid",
            "title": "Event Id",
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "session_id": {
            "format": "uuid",
            "title": "Session Id",
            "type": "string"
          },
          "call_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Call Id"
          },
          "sequence": {
            "title": "Sequence",
            "type": "integer"
          },
          "metadata": {
            "additionalProperties": true,
            "title": "Metadata",
            "type": "object"
          },
          "data": {
            "$ref": "#/components/schemas/ChatCompletedPayload"
          }
        },
        "required": [
          "type",
          "event_id",
          "timestamp",
          "session_id",
          "sequence",
          "data"
        ],
        "title": "ChatCompletedEvent",
        "type": "object"
      },
      "ChatCompletedPayload": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "title": "Text",
            "type": "string"
          },
          "finish_reason": {
            "title": "Finish Reason",
            "type": "string"
          }
        },
        "required": [
          "text",
          "finish_reason"
        ],
        "title": "ChatCompletedPayload",
        "type": "object"
      },
      "ChatDeltaEvent": {
        "properties": {
          "type": {
            "const": "chat.delta",
            "title": "Type",
            "type": "string"
          },
          "event_id": {
            "format": "uuid",
            "title": "Event Id",
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "session_id": {
            "format": "uuid",
            "title": "Session Id",
            "type": "string"
          },
          "call_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Call Id"
          },
          "sequence": {
            "title": "Sequence",
            "type": "integer"
          },
          "metadata": {
            "additionalProperties": true,
            "title": "Metadata",
            "type": "object"
          },
          "data": {
            "$ref": "#/components/schemas/ChatDeltaPayload"
          }
        },
        "required": [
          "type",
          "event_id",
          "timestamp",
          "session_id",
          "sequence",
          "data"
        ],
        "title": "ChatDeltaEvent",
        "type": "object"
      },
      "ChatDeltaPayload": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "ChatDeltaPayload",
        "type": "object"
      },
      "ToolCallCompletedEvent": {
        "properties": {
          "type": {
            "const": "tool_call.completed",
            "title": "Type",
            "type": "string"
          },
          "event_id": {
            "format": "uuid",
            "title": "Event Id",
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "session_id": {
            "format": "uuid",
            "title": "Session Id",
            "type": "string"
          },
          "call_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Call Id"
          },
          "sequence": {
            "title": "Sequence",
            "type": "integer"
          },
          "metadata": {
            "additionalProperties": true,
            "title": "Metadata",
            "type": "object"
          },
          "data": {
            "$ref": "#/components/schemas/ToolCallCompletedPayload"
          }
        },
        "required": [
          "type",
          "event_id",
          "timestamp",
          "session_id",
          "sequence",
          "data"
        ],
        "title": "ToolCallCompletedEvent",
        "type": "object"
      },
      "ToolCallCompletedPayload": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "result": {
            "title": "Result"
          },
          "is_error": {
            "title": "Is Error",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "result",
          "is_error"
        ],
        "title": "ToolCallCompletedPayload",
        "type": "object"
      },
      "ToolCallStartedEvent": {
        "properties": {
          "type": {
            "const": "tool_call.started",
            "title": "Type",
            "type": "string"
          },
          "event_id": {
            "format": "uuid",
            "title": "Event Id",
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "session_id": {
            "format": "uuid",
            "title": "Session Id",
            "type": "string"
          },
          "call_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Call Id"
          },
          "sequence": {
            "title": "Sequence",
            "type": "integer"
          },
          "metadata": {
            "additionalProperties": true,
            "title": "Metadata",
            "type": "object"
          },
          "data": {
            "$ref": "#/components/schemas/ToolCallStartedPayload"
          }
        },
        "required": [
          "type",
          "event_id",
          "timestamp",
          "session_id",
          "sequence",
          "data"
        ],
        "title": "ToolCallStartedEvent",
        "type": "object"
      },
      "ToolCallStartedPayload": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "arguments": {
            "additionalProperties": true,
            "title": "Arguments",
            "type": "object"
          }
        },
        "required": [
          "name",
          "arguments"
        ],
        "title": "ToolCallStartedPayload",
        "type": "object"
      },
      "GatewayEventMessage": {
        "discriminator": {
          "mapping": {
            "chat.completed": "#/components/schemas/ChatCompletedEvent",
            "chat.delta": "#/components/schemas/ChatDeltaEvent",
            "tool_call.completed": "#/components/schemas/ToolCallCompletedEvent",
            "tool_call.started": "#/components/schemas/ToolCallStartedEvent"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/ChatDeltaEvent"
          },
          {
            "$ref": "#/components/schemas/ChatCompletedEvent"
          },
          {
            "$ref": "#/components/schemas/ToolCallStartedEvent"
          },
          {
            "$ref": "#/components/schemas/ToolCallCompletedEvent"
          }
        ]
      }
    }
  },
  "tags": [
    {
      "name": "system",
      "description": "Gateway availability."
    },
    {
      "name": "sessions",
      "description": "Conversation session lifecycle."
    }
  ]
}
